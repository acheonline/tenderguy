{
  "tools": {
    "approvalMode": "auto"
  },
  "agents": {
    "defaultBackground": false
  },
  "permissions": {
    "autoMode": {
      "environment": [
        "tenderguy — PoC-репозиторий на агентной разработке; рабочий конвейер: ветка feat/* → коммит → push ветки → gh pr create → CI. Мерж в main делает только человек."
      ],
      "hints": {
        "allow": [
          "go build/vet/test, gofmt, golangci-lint, go env, gh run view/watch/list, jq, curl",
          "git checkout -b, git add/commit по задаче [P*], git push -u origin feat/* и chore/*",
          "gh pr create и gh pr comment — доставка результата задачи PoC, часть согласованного конвейера"
        ],
        "deny": [
          "любой merge PR: gh pr merge, gh api .../merge, слияние в main — мерж только руками человека",
          "git push в main напрямую — только через PR"
        ]
      }
    },
    "deny": [
      "mcp__github",
      "Bash(gh pr merge*)",
      "Bash(gh api repos/*pulls/*/merge*)",
      "Bash(git push --force*)",
      "Bash(git push -f*)",
      "Bash(git push origin main*)",
      "Bash(git reset --hard*)",
      "Bash(git clean -f*)",
      "Bash(git checkout -- .*)",
      "Bash(git commit --no-verify*)",
      "Bash(rm -rf *)",
      "Read(.env)"
    ]
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "run_shell_command",
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"$QWEN_PROJECT_DIR/.qwen/hooks/pretool_guard.py\"",
            "name": "tenderguy-guard",
            "timeout": 20
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "edit|write_file",
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"$QWEN_PROJECT_DIR/.qwen/hooks/posttool_go.py\"",
            "name": "tenderguy-gofmt",
            "timeout": 30
          }
        ]
      }
    ],
    "SubagentStop": [
      {
        "matcher": "go-dev|testing-expert",
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"$QWEN_PROJECT_DIR/.qwen/hooks/subagentstop_evidence.py\"",
            "name": "tenderguy-evidence",
            "timeout": 20
          }
        ]
      }
    ]
  },
  "$version": 4
}
